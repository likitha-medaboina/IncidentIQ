{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IncidentIQ: Start Backend Server",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "IncidentIQ: Run CLI Demo",
      "type": "shell",
      "command": "python demo.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "IncidentIQ: Run Pytest",
      "type": "shell",
      "command": "python -m pytest tests/ -v",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "IncidentIQ: Start Vite Frontend (Dev Mode)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
